# Calendly Scheduling Integration
# Replace with your personal Calendly event URL (e.g. 15-minute or 30-minute booking page)
# When set, the interactive Meeting Scheduler modal will embed your live Calendly widget.
VITE_CALENDLY_URL=https://calendly.com/YOUR_USERNAME/introductory-meeting

# Optional: Custom Contact Form Backend Endpoint (e.g. Resend, EmailJS, Cloudflare Worker, or Serverless API)
# If left empty, the contact form automatically triggers a pre-filled client mailto transmission.
# VITE_CONTACT_ENDPOINT=https://your-api-domain.com/api/contact
